# Environment variables template
# Copy this file to .env and adjust variables as needed

# City input (e.g. 'Hyderabad', 'Bengaluru', 'Delhi')
CITY=Hyderabad

# Optional: If LATITUDE & LONGITUDE are omitted or blank, the scraper automatically
# queries the Location Search API with CITY, finds all matching suggestions,
# and auto-discovers coordinates (latlums).
LATITUDE=
LONGITUDE=

# Pagination Parameters
START_PAGE=1
START_OFFSET=0
PAGE_INCREMENT=1
OFFSET_INCREMENT=12
# Max pages: Leave blank for unlimited
MAX_PAGES=
# Max review pages to scrape per restaurant (e.g. 5, 10, or blank for all)
MAX_REVIEW_PAGES=

# Scraper Network Settings
REQUEST_TIMEOUT=30
REQUEST_DELAY=1.0
OUTPUT_DIR=output

# MongoDB Database Configuration
ENABLE_MONGO=true
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=zomato
MONGO_COLLECTION=restaurants
MONGO_DETAILS_COLLECTION=restaurants_data
MONGO_REVIEWS_COLLECTION=reviews
MONGO_DELIVERY_COLLECTION=delivery_data

# Optional Overrides (Leave empty to auto-extract session cookies and CSRF token)
ZOMATO_CSRF=
ZOMATO_COOKIE=
