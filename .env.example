# ==============================================================================
# Zomato Scraper - Environment Configuration Template
# Copy this file to .env and configure with your local environment values:
#   cp .env.example .env
# ==============================================================================

# Redis Configuration (Dedicated DB 1 for Zomato-Scraper queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
RQ_DASHBOARD_REDIS_URL=redis://127.0.0.1:6379/1
SINGLE_QUEUE_NAME=zomato

# Request Delays (0.4s for general requests, 1.0s for reviews)
REQUEST_DELAY=0.4
REVIEWS_REQUEST_DELAY=1.0

# PostgreSQL Configuration
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=zomato-scraper
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_SCHEMA=zomato

# Slack Alerts Configuration
# Paste your Slack Incoming Webhook URL here:
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_ALERT_ENABLED=true
SLACK_MIN_SUCCESS_RATE=99.0

# Optional Slack Bot Token (alternative to incoming webhook)
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
